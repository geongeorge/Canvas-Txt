{
  "name": "canvas-txt-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --filter @canvas-txt/docs dev",
    "build": "pnpm --filter canvas-txt build",
    "build:docs": "pnpm --filter @canvas-txt/docs build",
    "test": "pnpm --filter canvas-txt test",
    "test:watch": "pnpm --filter canvas-txt test:watch"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}
